<?xml version="1.0" encoding="utf-8" ?>
<Format
  xmlns="Parser/Binary"
  xmlns:xml="http://www.w3.org/XML/1998/namespace"
  
  targetNamespace="Parser/Binary" name="wad" type="binary">
  <Data>
    <Global name="file_id" type="string"/>
    <List name="directory" type="DirectoryEntry"/>
    <Global name="numlumps" type="int"/>
    <Global name="diroffset" type="int"/>
  </Data>
  <Instructions>
    <Label>Start</Label>
    <GotoOpIndex target="2"/>
    <ReadData scope="global" name="file_id" type="string" length="4"/>
    <ReadData scope="global" name="numlumps" type="int"/>
    <ReadData scope="global" name="diroffset" type="int"/>
    <JumpTo position_var="diroffset"/>
    <MakeList scope="global" name="directory" type="DirectoryEntry"/>
    <ForCount length_var="numlumps" counter_var="index">
      <ReadData name="lump_pos" type="int" scope ="local"/>
      <ReadData name="lump_size" type="int"/>
      <ReadData name="lump_name" type="string" length="8"/>
      <SavePos scope="global" name="directory_pos"/>
      <JumpTo position_var="lump_pos"/>
      <ReadData name="lump_data" type="binary" length_var="lump_size"/>
      <JumpTo position_var="directory_pos"/>
      <AddItem name="directory" type="DirectoryEntry">lump_pos,lump_size,lump_name,lump_data</AddItem>
    </ForCount>
    <Terminate success="true"/>
    <Conditional>
      <Condition>[file_id] == ["WAD2"]</Condition>
      <IfTrue></IfTrue>
      <IfFalse></IfFalse>
    </Conditional>
    <Switch>
      <Condition>[file_id]</Condition>
      <Case item="WAD2">
        <ReadData name="lump_data" type="binary" length_var="lump_size"/>
      </Case>
    </Switch>
    <SavePos scope="global" name="directory_pos"/>
    <ReadData name="lump_data" type="binary" length_var="lump_size"/>
  </Instructions>
</Format>