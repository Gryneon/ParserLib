<?xml version="1.0" encoding="utf-8" ?>
<Specs xmlns="Parser/Spec">
  <Spec>
    <Name>wad</Name>
    <Instructions>
      <Tokenize content_var="text" output_var="tokens"/>
      <Label name="Start"/>
      <MakeCursor cursor_var="current_pos" position="0"/>
      <GotoOpIndex target="2"/>
      <GotoLabel name="Start"/>
      <ReadData scope="global" content_var="bytes" output_var="file_id" type="text" length="4" cursor_var="current_pos"/>
      <ReadData scope="global" content_var="bytes" output_var="numlumps" type="int" cursor_var="current_pos"/>
      <ReadData scope="global" content_var="bytes" output_var="diroffset" type="int" cursor_var="current_pos"/>
      <SetCursorPos cursor_var="current_pos" position_var="diroffset"/>
      <Initialize scope="global" initial_var="directory" type="Collection" value_type="DirectoryEntry"/>
      <ForCount length_var="numlumps" counter_var="index">
        <ReadData output_var="lump_pos" content_var="bytes" type="int" scope="local" cursor_var="current_pos"/>
        <ReadData output_var="lump_size" content_var="bytes" type="int" scope="local" cursor_var="current_pos"/>
        <ReadData output_var="lump_name" content_var="bytes" type="text" length="8" scope="local" cursor_var="current_pos"/>
        <ReadData output_var="lump_data" content_var="bytes" type="binary" length_var="lump_size" position_var="lump_pos" scope="local"/>
        <AddItem name="directory" type="DirectoryEntry">lump_pos lump_size lump_name lump_data</AddItem>
      </ForCount>
      <ForEach list_var="list_of_items" item_var="current_item">
        <ReadData output_var="lump_pos" content_var="bytes" type="text" scope="local" cursor_var="current_pos" length_var="current_item"/>
      </ForEach>
      <IfBlock>
        <If condition="[file_id] == ['WAD2']">
          <!-- WAD2 File -->
          <!-- <Initialize initial_var="s" type="Collection" value_type="d"/> -->
        </If>
        <ElseIf condition="[file_id] == ['PACK']">
          <!-- PAK File -->
          <Initialize initial_var="s" type="Set" value_type="d"/>
        </ElseIf>
        <Else>
          <!-- WAD File -->
        </Else>
      </IfBlock>
      <Switch condition="[file_id]">
        <Case value="WAD2">
          
        </Case>
        <Default>
          <!-- WAD File -->
        </Default>
      </Switch>
      <Terminate success="true"/>
    </Instructions>
    <FileInferences initial="and">
      <Extension>wad</Extension>
      <Or>
        <Header>IWAD</Header>
        <Header>PWAD</Header>
      </Or>
    </FileInferences>
  </Spec>
</Specs>