<Window x:Class="SerialSenderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DT FEM ECM Washing Machine" Height="400" Width="600">
  <DockPanel>

    <!-- Status Bar -->
    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock Name="StatusText" Text="Ready"/>
    </StatusBar>

    <!-- Main Content -->
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Serial Input -->
      <TextBox Name="SerialInput"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     />

      <!-- Button -->
      <Button Grid.Row="1"
                    Content="Send to Server"
                    Height="30"
                    Margin="0,10,0,0"
                    Click="SendButton_Click"/>
    </Grid>

  </DockPanel>
</Window>