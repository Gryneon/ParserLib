<?xml version="1.0" encoding="utf-8"?>
<xs:schema
  targetNamespace="Parser/Operation"
  attributeFormDefault="qualified"
  elementFormDefault="qualified"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:op="Parser/Operation"
  xml:lang="en-us">

  <xs:include schemaLocation="Operation.Instructions.xsd"/>
  
  
  <xs:complexType name ="InstructionSet">
    <xs:sequence maxOccurs="unbounded">
      <xs:group ref="op:AnyOperation" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  
  <xs:group name="AnyOperation">
    <xs:choice>
      
    </xs:choice>
  </xs:group>

  <xs:element name="Instructions" type="op:InstructionSet"/>

</xs:schema>