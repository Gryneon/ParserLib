<?xml version="1.0" encoding="utf-8"?>
<Spec xmlns="Parser/Spec" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="Parser\Spec ..\Schemas\Spec.xsd">
    <Name>pak</Name>
    <TextFile>false</TextFile>
    
    <Instructions>
      <Label name="Start"/>
      <MakeCursor cursor_var="current_pos" cursor_ref="bytes" position="0"/>
      <ReadData scope="global" output_var="file_id" type="text" length="4" cursor_var="current_pos"/>
      <ReadData scope="global" output_var="diroffset" type="int" cursor_var="current_pos"/>
      <ReadData scope="global" output_var="dirsize" type="int" cursor_var="current_pos"/>
      <Divide dividend_var="dirsize" divisor="64" output_var="entrycount"/>
      <SetCursorPos cursor_var="current_pos" position_var="diroffset"/>
      <Initialize initial_var="directory" type="Collection" value_type="WadLump"/>
      <ForCount length_var="entrycount" cursor_var="index">
        <ReadData output_var="lump_name" type="text" length="50" cursor_var="current_pos"/>
        <ReadData output_var="lump_offset" type="int" cursor_var="current_pos"/>
        <ReadData output_var="lump_size" type="int" cursor_var="current_pos"/>
        <ReadData output_var="lump_data" content_var="bytes" type="binary" length_var="lump_size" position_var="lump_offset"/>
        <AddItem name="directory" type="WadLump">lump_offset lump_size lump_name lump_data</AddItem>
      </ForCount>
      <Terminate success="true"/>
    </Instructions>

    <FileInferences initial="and">
      <Extension>pak</Extension>
      <Header>PACK</Header>
    </FileInferences>
  </Spec>
