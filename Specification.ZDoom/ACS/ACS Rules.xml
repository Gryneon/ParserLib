    <Data >%</Data>
    </Rule>
  <Rule index = "33">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Binary</TypeToAssign>
    <Data >|</Data>
    </Rule>
  <Rule index = "34">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Binary</TypeToAssign>
    <Data >&amp;</Data>
    </Rule>
  <Rule index = "35">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Binary</TypeToAssign>
    <Data >^</Data>
    </Rule>
  <Rule index = "36">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Binary</TypeToAssign>
    <Data >*</Data>
    </Rule>
  <Rule index = "37">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Binary</TypeToAssign>
    <Data >&gt;</Data>
    </Rule>
  <Rule index = "38">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Binary</TypeToAssign>
    <Data >&lt;</Data>
    </Rule>
  <Rule index = "39">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Ao</TypeToAssign>
    <Data >[</Data>
    </Rule>
  <Rule index = "40">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Ac</TypeToAssign>
    <Data >]</Data>
    </Rule>
  <Rule index = "41">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Bo</TypeToAssign>
    <Data >{</Data>
    </Rule>
  <Rule index = "42">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Bc</TypeToAssign>
    <Data >}</Data>
    </Rule>
  <Rule index = "43">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Po</TypeToAssign>
    <Data >(</Data>
    </Rule>
  <Rule index = "44">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Pc</TypeToAssign>
    <Data >)</Data>
    </Rule>
  <Rule index = "45">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Eq</TypeToAssign>
    <Data >=</Data>
    </Rule>
  <Rule index = "46">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Cm</TypeToAssign>
    <Data >,</Data>
    </Rule>
  <Rule index = "47">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Co</TypeToAssign>
    <Data >:</Data>
    </Rule>
  <Rule index = "48">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Sc</TypeToAssign>
    <Data >;</Data>
    </Rule>
  <Rule index = "49">
    <Type >TokenExact, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Minus</TypeToAssign>
    <Data >-</Data>
    </Rule>
  <Rule index = "50">
    <Type >TokenMatch, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Void</TypeToAssign>
    <Data >\bvoid\b</Data>
    </Rule>
  <Rule index = "51">
    <Type >TokenMatch, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Type</TypeToAssign>
    <Data >\b(int|str|char|bool)\b</Data>
    </Rule>
  <Rule index = "52">
    <Type >TokenMatch, ExemptAllWithin, IgnoreCase</Type>
    <TypeToAssign >Name</TypeToAssign>
    <Data >\b[a-z_][\w]*\b</Data>
    </Rule>
  </RuleSet>