<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="TokenRule"
    targetNamespace="Parser/TokenRule"
    elementFormDefault="qualified"
    xmlns="Parser/TokenRule"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>
  <xs:complexType name="RuleTypeDef">
    <xs:sequence>
      <xs:element name="Flag" type="xs:token" default="None" maxOccurs="unbounded" minOccurs="0" nillable="true"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RuleDef">
    <xs:all>
      <xs:element name="AssignType" minOccurs="0" maxOccurs="1" type="xs:token" default="None"/>
      <xs:element name="RuleType" type="RuleTypeDef" minOccurs="0" maxOccurs="1"/>
      <xs:element name="Data" minOccurs="0" maxOccurs="1" default="" type="xs:string"/>
    </xs:all>
    <xs:attribute name="name" type="xs:token"/>
  </xs:complexType>
  <xs:element name="RuleSet">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Rule" type="RuleDef" maxOccurs="unbounded" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="spec" type="xs:normalizedString"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
